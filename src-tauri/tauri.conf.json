{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geode",
  "version": "0.1.0",
  "identifier": "dev.littlesquirt1.geode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Geode",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**", "$HOME/.local/share/geode/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Game",
    "shortDescription": "Minecraft launcher and mod manager",
    "longDescription": "Geode is a fast, native Minecraft launcher with first-class Modrinth and CurseForge mod management.",
    "linux": {
      "deb": { "desktopTemplate": "geode.desktop.hbs" },
      "rpm": { "desktopTemplate": "geode.desktop.hbs" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["geode"] }
    },
    "updater": {
      "endpoints": [
        "https://github.com/cody-cline/geode/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": true
    }
  }
}

# Copy to `.env` (in this directory or src-tauri/) and fill in what you have.
# `.env` is gitignored — keep it that way, these are per-developer credentials.
#
# Values here are compiled into the binary, so they survive a wiped config and
# never need pasting into Settings. This file is read directly, so no quoting is
# needed even though CurseForge keys are full of `$`.
#
# A real environment variable overrides the file — but on a command line you
# MUST single-quote, or the shell eats the `$` parts:
#   GEODE_CURSEFORGE_KEY='$2a$10$...' npm run tauri build
#
# Only bake keys into builds you keep. CurseForge's terms forbid disclosing a
# key to a third party, and handing someone a binary containing one does that.

# https://console.curseforge.com/  — free, enables CurseForge search/installs
GEODE_CURSEFORGE_KEY=

# Azure application (client) ID for Microsoft sign-in. Not needed if you import
# a session from another launcher, or only play offline.
GEODE_CLIENT_ID=

# Google OAuth client ID (Desktop app, Drive API enabled) for sharing a pack
# through your own Drive. Not needed to export a .geodepack and hand it over.
GEODE_GOOGLE_CLIENT_ID=

# The public half of the updater signing keypair, from `geode.key.pub`. Only
# useful if you are the one cutting releases: it is what a build will verify an
# update's signature against, and a build without it has no updater at all.
# Unlike the keys above this one is not secret — it ships inside the binary.
# The private half belongs in CI and nowhere else; see docs/releasing.md.
GEODE_UPDATER_PUBKEY=
